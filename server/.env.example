# ─────────────────────────────────────────────────────────────────────────────
# Jojo AI — reference hosted service. Copy to `.env` and fill in.
# NOTHING real is committed: only this example. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ============ control plane (server/control-plane) ==========================
# The always-on half: mints/revokes login tokens, owns accounts/grants/config,
# answers the backend's authz checks. Runs even when the DGX is powered off.

JOJOAI_CP_HOST=127.0.0.1
JOJOAI_CP_PORT=7460

# 'memory'  — in-process store, no database (dev / CI / demo).
# 'prisma'  — PostgreSQL via server/shared/prisma/schema.prisma (production).
JOJOAI_CP_STORE=memory
JOJOAI_DATABASE_URL=postgresql://jojoai:CHANGE_ME@127.0.0.1:5432/jojoai

# Shared secret the DGX backend presents on POST /api/authz/check.
# Generate: openssl rand -base64 32
JOJOAI_SERVICE_TOKEN=CHANGE_ME_generate_a_long_random_string

# One-time codes
JOJOAI_OTP_TTL_MIN=10
JOJOAI_OTP_LENGTH=6
JOJOAI_OTP_MAX_ATTEMPTS=5
JOJOAI_OTP_RPH=5                 # max OTP requests per email per hour

# Token lifetime ceiling (also capped by the active grant's expiry)
JOJOAI_SESSION_TTL_HOURS=12

# OTP delivery: 'console' (stderr + ~/.local/share/jojoai/otp-outbox.log) or 'smtp'
JOJOAI_MAIL=console
JOJOAI_SMTP_URL=smtp://user:pass@smtp.example.com:587
JOJOAI_MAIL_FROM=Jojo AI <no-reply@example.com>

# Seed on first boot
JOJOAI_OWNER_EMAIL=owner@example.com      # created as an APPROVED SUPERADMIN
# JSON array; each entry: { email, displayName?, status?, role?, accessMode?, grantDays? }
JOJOAI_SEED=[{"email":"dev@example.com","displayName":"Dev","status":"APPROVED","role":"USER","grantDays":30}]

# ============ DGX backend (server/backend) ==================================
JOJOAI_HOST=127.0.0.1
JOJOAI_PORT=7420
JOJOAI_OLLAMA_URL=http://127.0.0.1:11434
JOJOAI_MODEL=gpt-oss:120b
JOJOAI_MAX_SEATS=4               # F1: OLLAMA_NUM_PARALLEL operating point

# Wire the backend to the control plane for real auth. When BOTH are set the
# backend validates every token via the control plane and fails CLOSED if it is
# unreachable. When unset it falls back to the shared demo code below.
JOJOAI_CONTROL_PLANE_URL=http://127.0.0.1:7460
# JOJOAI_SERVICE_TOKEN is shared with the control plane (same value as above).

# Demo-only fallback auth (ignored once the control plane is wired)
JOJOAI_DEMO_CODE=change-me-demo-code

# Static assets
JOJOAI_WEB_DIR=../../web
JOJOAI_INSTALL_DIR=../../install

# Orchestrator guards
JOJOAI_MAX_ITERS=24
JOJOAI_TURN_MS=600000
JOJOAI_TOOL_MS=120000

# ============ payments (T11, stubbed) ======================================
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
