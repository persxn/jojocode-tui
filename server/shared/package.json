{
  "name": "@jojoai/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts",
    "./authorize": "./src/authorize.ts",
    "./rbac": "./src/rbac.ts"
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "JOJOAI_DATABASE_URL=${JOJOAI_DATABASE_URL:-postgresql://u:p@localhost:5432/jojoai} prisma validate --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  }
}
